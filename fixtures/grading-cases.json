  "classificationBoundaries": [
    { "classification": "FIRST_CLASS_WITH_HONORS", "minCgpa": 3.75 },
    { "classification": "FIRST_CLASS", "minCgpa": 3.0 },
    { "classification": "SECOND_CLASS", "minCgpa": 2.2 },
    { "classification": "FAIL", "minCgpa": null }
  ],
