    { "marksObtained": 36, "maxMarks": 40, "incomplete": false, "expected": { "letterGrade": "A+", "gradePoint": 4.0, "percentage": 90, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
