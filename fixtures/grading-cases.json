    { "marksObtained": 74.9, "maxMarks": 100, "incomplete": false, "expected": { "letterGrade": "A-", "gradePoint": 3.5, "percentage": 74.9, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
    { "marksObtained": 70, "maxMarks": 100, "incomplete": false, "expected": { "letterGrade": "A-", "gradePoint": 3.5, "percentage": 70, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
    { "marksObtained": 69.9, "maxMarks": 100, "incomplete": false, "expected": { "letterGrade": "B+", "gradePoint": 3.25, "percentage": 69.9, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
    { "marksObtained": 65, "maxMarks": 100, "incomplete": false, "expected": { "letterGrade": "B+", "gradePoint": 3.25, "percentage": 65, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
    { "marksObtained": 60, "maxMarks": 100, "incomplete": false, "expected": { "letterGrade": "B", "gradePoint": 3.0, "percentage": 60, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
