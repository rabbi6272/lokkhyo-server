    { "marksObtained": 0, "maxMarks": 100, "incomplete": true, "expected": { "letterGrade": "I", "gradePoint": null, "percentage": 0, "status": "INCOMPLETE", "countsTowardGPA": false, "countsAsEarnedCredit": false } }
  ],
  "gpaComputations": [
    {
      "name": "Standard credit-weighted mean",
      "entries": [
        { "credits": 4, "gradePoint": 4.0, "countsTowardGPA": true },
        { "credits": 1, "gradePoint": 2.0, "countsTowardGPA": true }
      ],
      "expected": {
        "gpa": 3.6,
        "totalCredits": 5,
        "totalWeightedPoints": 18,
        "coursesCounted": 2
      }
    },
    {
      "name": "Excludes F from both numerator and denominator",
      "entries": [
        { "credits": 3, "gradePoint": 4.0, "countsTowardGPA": true },
        { "credits": 3, "gradePoint": 0.0, "countsTowardGPA": false }
      ],
      "expected": {
        "gpa": 4.0,
        "totalCredits": 3,
        "totalWeightedPoints": 12,
        "coursesCounted": 1
      }
    },
    {
      "name": "Excludes I with null gradePoint",
      "entries": [
        { "credits": 3, "gradePoint": 3.5, "countsTowardGPA": true },
        { "credits": 3, "gradePoint": null, "countsTowardGPA": false }
      ],
      "expected": {
        "gpa": 3.5,
        "totalCredits": 3,
        "totalWeightedPoints": 10.5,
        "coursesCounted": 1
      }
    },
    {
      "name": "Zero credits returns null GPA",
      "entries": [
        { "credits": 3, "gradePoint": 0.0, "countsTowardGPA": false }
      ],
      "expected": {
        "gpa": null,
        "totalCredits": 0,
        "totalWeightedPoints": 0,
        "coursesCounted": 0
      }
    },
    {
      "name": "Floating point round2 boundary (3.745 -> 3.75)",
      "entries": [
        { "credits": 1000, "gradePoint": 3.745, "countsTowardGPA": true }
      ],
      "expected": {
        "gpa": 3.75,
        "totalCredits": 1000,
        "totalWeightedPoints": 3745,
        "coursesCounted": 1
      }
    }
  ],
  "cgpaProjections": [
    {
      "name": "Projected CGPA from base unrounded sums",
      "base": { "totalCredits": 15, "totalWeightedPoints": 55.5 },
      "added": [
        { "credits": 3, "gradePoint": 4.0, "countsTowardGPA": true }
      ],
      "expected": {
        "projectedCgpa": 3.75,
        "projectedCredits": 18,
        "projectedWeightedPoints": 67.5,
        "classification": "FIRST_CLASS_WITH_HONORS",
        "isDegreeEligible": true
      }
    },
    {
      "name": "Retake replaces previous attempt points and credits",
      "base": { "totalCredits": 15, "totalWeightedPoints": 55.5 },
      "retake": { "oldCredits": 3, "oldGradePoint": 1.5 },
      "added": [
        { "credits": 3, "gradePoint": 3.75, "countsTowardGPA": true }
      ],
      "expected": {
        "projectedCgpa": 4.15,
        "projectedCredits": 15,
        "projectedWeightedPoints": 62.25,
        "classification": "FIRST_CLASS_WITH_HONORS",
        "isDegreeEligible": true
      }
    }
  ],
  "classifications": [
    { "cgpa": 3.75, "expected": { "classification": "FIRST_CLASS_WITH_HONORS", "isDegreeEligible": true } },
    { "cgpa": 3.0, "expected": { "classification": "FIRST_CLASS", "isDegreeEligible": true } },
    { "cgpa": 2.2, "expected": { "classification": "SECOND_CLASS", "isDegreeEligible": true } },
    { "cgpa": 2.19, "expected": { "classification": "FAIL", "isDegreeEligible": false } },
    { "cgpa": null, "expected": { "classification": "IN_PROGRESS", "isDegreeEligible": false } }
  ],
  "gradeImprovement": [
    { "letterGrade": "D", "cgpa": 2.19, "expected": true },
    { "letterGrade": "D", "cgpa": 2.2, "expected": false },
    { "letterGrade": "D", "cgpa": null, "expected": false },
    { "letterGrade": "C-", "cgpa": 2.0, "expected": false },
    { "letterGrade": "F", "cgpa": 1.5, "expected": false }
  ]
}

