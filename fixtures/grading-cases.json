    { "letterGrade": "F", "minPercentage": 0, "gradePoint": 0.0, "countsTowardGPA": false, "countsAsEarnedCredit": false },
    { "letterGrade": "I", "minPercentage": null, "gradePoint": null, "countsTowardGPA": false, "countsAsEarnedCredit": false }
