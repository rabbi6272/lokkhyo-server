    { "marksObtained": 79.9, "maxMarks": 100, "incomplete": false, "expected": { "letterGrade": "A", "gradePoint": 3.75, "percentage": 79.9, "status": "PASSED", "countsTowardGPA": true, "countsAsEarnedCredit": true } },
